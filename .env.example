# Archivo de ejemplo para configuración de credenciales NREL / NSRDB API
# Copia este archivo con el nombre '.env' y reemplaza con tus valores:
#   cp .env.example .env
#
# Obtén tu API Key gratuita en https://developer.nlr.gov o https://developer.nrel.gov

NREL_API_KEY=tu_api_key_aqui
NREL_API_EMAIL=tu_correo@ejemplo.com
