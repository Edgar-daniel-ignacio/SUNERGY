  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.2",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
